<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Medicinemanage1Page">

    <View
        android:id="@+id/topBackground"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/home_top_bg"
        android:backgroundTint="@color/header_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medicare"
                android:textColor="@color/blue_main"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/plus"
                android:textColor="@color/green_main"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="@string/medicine_manager"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/addMedicineCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_new_medicine"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/medicine_name"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/edittext_bg"
                android:hint="@string/enter_medicine_name"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/time_label"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/edittext_bg"
                android:hint="@string/time_placeholder"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:importantForAutofill="no"
                android:inputType="time" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/addButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_gradient"
                    android:backgroundTint="@color/add_btn_bg"
                    android:text="@string/add_plus"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/updateButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_gradient"
                    android:backgroundTint="@color/disabled_btn_bg"
                    android:text="@string/update"
                    android:textAllCaps="false"
                    android:textColor="@color/grey_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/myMedicinesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/my_medicines"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addMedicineCard" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myMedicinesTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Medicine Item 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F9F9F9"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <View
                        android:id="@+id/iconBg1"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/back_button_bg"
                        android:backgroundTint="#4DB6AC"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_medicine_bottle"
                        app:layout_constraintBottom_toBottomOf="@id/iconBg1"
                        app:layout_constraintEnd_toEndOf="@id/iconBg1"
                        app:layout_constraintStart_toStartOf="@id/iconBg1"
                        app:layout_constraintTop_toTopOf="@id/iconBg1"
                        android:contentDescription="@string/medicine_manager" />

                    <TextView
                        android:id="@+id/medName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/vitamin_c"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconBg1"
                        app:layout_constraintTop_toTopOf="@id/iconBg1" />

                    <ImageView
                        android:id="@+id/clockIcon1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_clock"
                        app:layout_constraintStart_toStartOf="@id/medName1"
                        app:layout_constraintTop_toBottomOf="@id/medName1"
                        android:contentDescription="@string/time_label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/time_8am"
                        android:textColor="@color/grey_text"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="@id/clockIcon1"
                        app:layout_constraintStart_toEndOf="@id/clockIcon1"
                        app:layout_constraintTop_toTopOf="@id/clockIcon1" />

                    <ImageButton
                        android:id="@+id/deleteBtn1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/edittext_bg"
                        android:backgroundTint="@color/delete_bg"
                        android:src="@drawable/ic_delete"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="@string/cancel" />

                    <ImageButton
                        android:id="@+id/editBtn1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/edittext_bg"
                        android:backgroundTint="@color/update_btn"
                        android:src="@drawable/ic_edit"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/deleteBtn1"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="@string/update" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medicine Item 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F9F9F9"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <View
                        android:id="@+id/iconBg2"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/back_button_bg"
                        android:backgroundTint="#4DB6AC"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_medicine_bottle"
                        app:layout_constraintBottom_toBottomOf="@id/iconBg2"
                        app:layout_constraintEnd_toEndOf="@id/iconBg2"
                        app:layout_constraintStart_toStartOf="@id/iconBg2"
                        app:layout_constraintTop_toTopOf="@id/iconBg2"
                        android:contentDescription="@string/medicine_manager" />

                    <TextView
                        android:id="@+id/medName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/penadol"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconBg2"
                        app:layout_constraintTop_toTopOf="@id/iconBg2" />

                    <ImageView
                        android:id="@+id/clockIcon2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_clock"
                        app:layout_constraintStart_toStartOf="@id/medName2"
                        app:layout_constraintTop_toBottomOf="@id/medName2"
                        android:contentDescription="@string/time_label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/time_8am"
                        android:textColor="@color/grey_text"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toBottomOf="@id/clockIcon2"
                        app:layout_constraintStart_toEndOf="@id/clockIcon2"
                        app:layout_constraintTop_toTopOf="@id/clockIcon2" />

                    <ImageButton
                        android:id="@+id/deleteBtn2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/edittext_bg"
                        android:backgroundTint="@color/delete_bg"
                        android:src="@drawable/ic_delete"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="@string/cancel" />

                    <ImageButton
                        android:id="@+id/editBtn2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/edittext_bg"
                        android:backgroundTint="@color/update_btn"
                        android:src="@drawable/ic_edit"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/deleteBtn2"
                        app:layout_constraintTop_toTopOf="parent"
                        android:contentDescription="@string/update" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>