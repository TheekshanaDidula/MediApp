<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/medCard"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="#F9F9F9"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/medItemContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">

        <View
            android:id="@+id/iconBg"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/back_button_bg"
            android:backgroundTint="#4DB6AC"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/medIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_medicine_bottle"
            app:layout_constraintBottom_toBottomOf="@id/iconBg"
            app:layout_constraintEnd_toEndOf="@id/iconBg"
            app:layout_constraintStart_toStartOf="@id/iconBg"
            app:layout_constraintTop_toTopOf="@id/iconBg"
            android:contentDescription="@string/medicine_manager" />

        <TextView
            android:id="@+id/medName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/vitamin_c"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iconBg"
            app:layout_constraintTop_toTopOf="@id/iconBg" />

        <ImageView
            android:id="@+id/clockIcon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_clock"
            app:layout_constraintStart_toStartOf="@id/medName"
            app:layout_constraintTop_toBottomOf="@id/medName"
            android:contentDescription="@string/time_label" />

        <TextView
            android:id="@+id/medTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/time_8am"
            android:textColor="@color/grey_text"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/clockIcon"
            app:layout_constraintStart_toEndOf="@id/clockIcon"
            app:layout_constraintTop_toTopOf="@id/clockIcon" />

        <ImageButton
            android:id="@+id/deleteBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/edittext_bg"
            android:backgroundTint="@color/delete_bg"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/cancel" />

        <ImageButton
            android:id="@+id/editBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/edittext_bg"
            android:backgroundTint="@color/update_btn"
            android:src="@drawable/ic_edit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/deleteBtn"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/update" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>